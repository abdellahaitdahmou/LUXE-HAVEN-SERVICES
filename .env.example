# =============================================================================
# StayBeldi — Environment Variables (.env.example)
# Copy this file to .env.local and fill in your credentials.
# Never expose SUPABASE_SERVICE_ROLE_KEY or AI API keys in client-side code.
# =============================================================================

# Public Application URL (used for QR codes and NFC link generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket Name
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=staybeldi-media

# Hostaway PMS Integration (Optional — can also be configured in Admin Dashboard)
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# Server-Side AI Configuration for Service Suggestions (Optional)
# Supports OpenAI-compatible APIs (OpenAI, Gemini OpenAI-compatible endpoint, or Anthropic/Groq)
# When omitted or unreachable, StayBeldi automatically falls back to clearly labelled rule-based suggestions.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
